<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ⚠️ 必须放在主清单：debug/profile 清单里的 INTERNET 不会合入 release，
         漏掉的话 release 包所有网络请求 SocketException（且 debug 包一切正常，极难排查）。 -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 保存 AI 生成图到系统相册。Android 10(Q) 起 MediaStore 走分区存储、不需要权限，
         所以只在 Q 以下声明（maxSdkVersion="28"），不给新系统平添一条敏感权限。 -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- AI 聊天「按住说话」：端上语音识别要录音（speech_to_text → SpeechRecognizer）。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>
    <!-- 仅 Android ≤11（API ≤30）BLE 扫描需要定位；12+ 已由 BLUETOOTH_SCAN(neverForLocation) 覆盖，
         限定 maxSdkVersion 避免新系统上多声明一个商店审核会追问的敏感权限。 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30"/>
    <!-- BLE 连接保活前台服务（BleConnectionService）：连接期间挂通知提升进程优先级，
         否则国产 ROM 切出 App 一分钟内就杀进程，「切出 15 分钟 / 息屏 30 分钟才断开」无从谈起。
         API 34+ 强制要求按类型声明；connectedDevice 类型的前置权限由 BLUETOOTH_CONNECT 满足。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <!-- BleConnectionService 与连接同生命周期持 PARTIAL_WAKE_LOCK：不持锁时息屏进
         Doze 后 Dart 侧心跳与租约定时器一起停摆，「切出 15 分钟 / 息屏 30 分钟后断开」
         永远走不到到期点，进程也就一直不可回收。租约到期即断开、停服务、释放锁。 -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Android 13+ 通知运行时权限：不主动弹窗索要——未授权时前台服务照常运行，
         仅通知不可见（系统「活跃应用」面板仍可见）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- 自定义 Application：进程创建即安装崩溃日志处理器（CrashLogger），
         「应用因自身原因导致崩溃」这类进程级崩溃才有现场可查。 -->
    <application
        android:label="BoltStar"
        android:name=".BoltStarApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- 投屏预览页的原生裁剪器（image_cropper 插件，Android 侧用 Yalantis uCrop）。
             必须在这里注册它的 Activity，否则点「裁剪」会直接崩（ActivityNotFoundException）。 -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />
        <!-- BLE 连接保活前台服务：与相框连接同生命周期（连接建立启动、断开即停）。 -->
        <service
            android:name=".BleConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <!-- ⚠️ 渲染后端兼容（修「登录后加载首页即崩，系统弹"应用因自身原因导致崩溃"」）：
             Flutter 3.4x 默认用 Impeller(Vulkan) 渲染，华为/荣耀等机型（Maleoon/部分 Mali GPU）
             的 Vulkan 驱动有缺陷，会在首个重渲染页面（登录后的首页：轮播+阴影+网络图）直接
             崩掉整个进程——JVM 崩溃日志里不会有记录（GPU 驱动层信号崩溃），正是"代码查不出
             毛病、真机必现"的特征。这两条把渲染退回兼容路径：
             ① EnableImpeller=false：回退 Skia（引擎已移除 Skia 的版本会忽略此条）；
             ② ImpellerBackend=opengles：①被忽略时退而求其次，Impeller 走 GLES 不走 Vulkan。
             若之后 last_crash.txt / adb logcat 证实崩溃与渲染无关，可移除这两条再回归验证。 -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />
        <meta-data
            android:name="io.flutter.embedding.android.ImpellerBackend"
            android:value="opengles" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- 微信授权登录：Android 11+（targetSdk≥30）的包可见性限制下，不声明这一条时
             微信 SDK 的 isWXAppInstalled 恒为 false —— 表现是装了微信也提示「请先安装微信」。 -->
        <package android:name="com.tencent.mm"/>
        <!-- 外部浏览器：星币购买的 PayPal 授权页、检查更新的 APK 下载地址都靠 url_launcher
             以 http(s) VIEW 意图跳出去（见 star_purchase.dart：PayPal 风控会拒一部分内嵌
             WebView 的登录，故一律走外部浏览器 / PayPal App）。Android 11+ 的包可见性限制下
             不声明这一条时，url_launcher 解析不到可用浏览器（canLaunchUrl 恒 false、
             部分机型 launchUrl 也直接返回 false），表现就是「点了没反应」。 -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <!-- AI 聊天「按住说话」：Android 11+ 的包可见性限制下不声明这一条时，
             SpeechRecognizer.isRecognitionAvailable() 恒为 false —— 表现是装了语音服务
             也按不出反应（与上面微信 / 浏览器两条是同一个坑）。 -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- 部分 ROM 只认按包名的可见性声明（上面那条按 action 查不到）。
             Google 语音服务由「Google」这个应用提供，显式再点一次名。
             ⚠️ 这两条都只解决「有服务但看不见」；**国行无 GMS 的机器根本没有这个服务**，
             声明再多也查不出来（见 `ai_voice_input.dart` 文件头的说明）。 -->
        <package android:name="com.google.android.googlequicksearchbox"/>
    </queries>
</manifest>
