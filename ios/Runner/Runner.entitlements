<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 微信 Universal Link 回调必需。当前域名 badmin.boltfox.cn，链接 https://badmin.boltfox.cn/app/。
	     该域名根目录需部署 /.well-known/apple-app-site-association
	     （appID = S2HZK3227W.com.boltfox.boltstar，paths 含 /app/ 与 /app/*，
	      内容见 docs/integration/apple-app-site-association.json），
	     并与微信开放平台后台、WECHAT_UNIVERSAL_LINK 默认值三处完全一致。 -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:badmin.boltfox.cn</string>
	</array>
</dict>
</plist>
