<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- 声明 App 支持的语种（Flutter 文案不走 lproj，系统靠这里和 *.lproj 判断本地化语言）。 -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
		<string>ja</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>BoltStar</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>BoltStar</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>weixin</string>
		<string>wechat</string>
		<string>weixinULAPI</string>
		<string>weixinURLParamsAPI</string>
	</array>
	<!-- 微信授权回调 URL Scheme（fluwx 必需）：值必须与实际使用的 AppID 完全一致
	     （见 WeChatAuthorizationConfig.fromEnvironment 的默认值 / dart-define 的 WECHAT_APP_ID），
	     否则微信授权后无法回跳 App。换环境改 AppID 时这里要同步改。 -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>weixin</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wx4cf0c5f38a70d0bc</string>
			</array>
		</dict>
	</array>
	<!-- 关掉 Flutter 的深链接管。本工程是 Navigator + `AppRoutes.onGenerateRoute`，只认命名路由，
	     从没打算吃外部 URL；而引擎在这个键缺省时按 YES 处理（FlutterSharedApplication
	     .isFlutterDeepLinkingEnabled）。开着的后果：微信按 URL Scheme 回跳、或 Universal Link
	     被 fluwx 漏接时，引擎把整条 URL 当路由名 push 给 Flutter → 命中 AppRoutes 的 default
	     分支 → 弹出「Route not found」页；Universal Link 那条还会在 Flutter 回报未处理时把链接
	     甩回系统（relayToSystemIfUnhandled:YES），表现为直接跳去 Safari。
	     微信回跳全部由 fluwx 的原生回调消费（见 SceneDelegate.swift 的转发），不需要 Flutter 深链。
	     ⚠️ 以后若真要做 App 内深链（比如分享落地页直达某页），改回 true 之前先给
	     AppRoutes 加 URL→路由的解析，否则会退回同一个坑。 -->
	<key>FlutterDeepLinkingEnabled</key>
	<false/>
	<!-- 仅使用 HTTPS 等豁免加密，免去 App Store Connect 每次上传的出口合规答题。 -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- iPhone 仅竖屏：全部页面按 375 宽竖屏设计（登录页 CustomPaint 坐标写死等），横屏必然错乱。 -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- 投屏中锁屏 / 切后台时保住 CoreBluetooth 会话。
	     没有这一项，iOS 会在 App 进入后台后很快挂起蓝牙中心角色，整批图传必断
	     （Android 侧对应的是 BleConnectionService 前台服务）。
	     ⚠️ 上架审核会问用途：如实答「与蓝牙相框保持连接以完成正在进行的照片传输」。
	     若产品最终不要求「投屏中可锁屏」，删掉这一项也不影响前台投屏。 -->
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
	</array>
	<!-- 权限弹框文案：这里的值是英文兜底（系统语言不在四语种内时显示，与 App 内兜底英文一致），
	     各语种实际文案在 en / zh-Hans / zh-Hant / ja.lproj/InfoPlist.strings，弹框语言跟随系统语言。
	     审核（Guideline 4，1.0.1(2)）要求权限文案与 App 本地化语言一致：新增或改动权限键时，
	     四个 InfoPlist.strings 要一起补齐。 -->
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>BoltStar uses Bluetooth to find and connect to your photo frame and send photos to it.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>BoltStar uses Bluetooth to connect to your photo frame and transfer photos.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>BoltStar uses your location only to search for nearby Bluetooth photo frames.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>BoltStar needs access to your photos so you can choose pictures to show on your photo frame.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>BoltStar saves AI-generated images to your photo library.</string>
	<key>NSCameraUsageDescription</key>
	<string>BoltStar uses the camera so you can take a photo and show it on your photo frame.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>BoltStar uses the microphone so you can press and hold to talk to the AI Assistant.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>BoltStar uses speech recognition to turn what you say into text for the AI Assistant.</string>
</dict>
</plist>
